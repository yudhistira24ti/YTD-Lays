<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/simaju_page_bg"
    android:padding="16dp">

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Katalog Produk HPAI"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/simaju_text_primary"
        android:layout_marginBottom="2dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Produk herbal terpercaya, berkualitas, &amp; halal"
        android:textSize="13sp"
        android:textColor="@color/simaju_text_secondary"
        android:layout_marginBottom="16dp" />

    <!-- Search Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_input_field"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:layout_marginBottom="16dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@android:drawable/ic_menu_search"
            app:tint="@color/simaju_text_secondary"
            android:layout_marginEnd="10dp"
            android:contentDescription="Search" />

        <EditText
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:hint="Cari produk herbal..."
            android:textSize="14sp"
            android:textColor="@color/simaju_text_primary"
            android:textColorHint="@color/simaju_text_secondary"
            android:focusable="false"
            android:clickable="true"
            android:importantForAutofill="no"
            android:inputType="text" />
    </LinearLayout>

    <!-- RecyclerView for Products -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewProducts"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="vertical" />

</LinearLayout>
