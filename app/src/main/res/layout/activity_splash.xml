<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/simaju_green"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    tools:context=".splash.SplashActivity">

    <!-- Logo Box -->
    <FrameLayout
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:background="@drawable/bg_tab_selected"
        android:padding="8dp"
        android:layout_marginBottom="20dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/desain_logo"
            android:scaleType="centerCrop"
            android:contentDescription="Logo SiMaju" />
    </FrameLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SiMaju"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="HPAI HERBAL"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#FFA726"
        android:letterSpacing="0.1"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Aplikasi Manajemen Penjualan &amp; Belanja HPAI"
        android:textSize="14sp"
        android:textColor="#E0F2F1"
        android:gravity="center" />

</LinearLayout>
