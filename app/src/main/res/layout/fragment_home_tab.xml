<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F9FBF9">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top Header Row: Avatar, Greeting, Notification -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <!-- Avatar Y -->
            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_tab_selected"
                android:layout_marginEnd="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="Y"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/simaju_green"
                    android:gravity="center" />
            </FrameLayout>

            <!-- Greeting -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Selamat pagi,"
                    android:textSize="13sp"
                    android:textColor="@color/simaju_text_secondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Halo, Yudhis 👋"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/simaju_text_primary" />
            </LinearLayout>

            <!-- Notification Bell -->
            <FrameLayout
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_tab_selected"
                android:padding="8dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@android:drawable/ic_popup_reminder"
                    app:tint="@color/simaju_text_primary"
                    android:contentDescription="Notifikasi" />
            </FrameLayout>
        </LinearLayout>

        <!-- Search Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_input_field"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@android:drawable/ic_menu_search"
                app:tint="@color/simaju_text_secondary"
                android:layout_marginEnd="12dp"
                android:contentDescription="Search" />

            <EditText
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:hint="Cari produk herbal..."
                android:textSize="14sp"
                android:textColor="@color/simaju_text_primary"
                android:textColorHint="@color/simaju_text_secondary"
                android:focusable="false"
                android:clickable="true"
                android:importantForAutofill="no"
                android:inputType="text" />
        </LinearLayout>

        <!-- Promo Banner Card -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:background="@drawable/bg_input_field"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/images"
                android:alpha="0.85"
                android:contentDescription="Promo Madu" />

            <!-- Dark Gradient Overlay for readability -->
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#66000000" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="16dp"
                android:gravity="bottom">

                <!-- Promo Tag -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PROMO SPESIAL"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:background="#FFA726"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Madu HPAI Diskon Hingga 25%"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/white" />
            </LinearLayout>
        </FrameLayout>

        <!-- Categories Horizontal Chips -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Chip 1: Semua -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_primary_button"
                    android:text="Semua"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:paddingHorizontal="20dp"
                    android:layout_marginEnd="8dp" />

                <!-- Chip 2: Madu -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_tab_selected"
                    android:text="Madu"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/simaju_text_primary"
                    android:gravity="center"
                    android:paddingHorizontal="20dp"
                    android:layout_marginEnd="8dp" />

                <!-- Chip 3: Minuman -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_tab_selected"
                    android:text="Minuman"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/simaju_text_primary"
                    android:gravity="center"
                    android:paddingHorizontal="20dp"
                    android:layout_marginEnd="8dp" />

                <!-- Chip 4: Suplemen -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_tab_selected"
                    android:text="Suplemen"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/simaju_text_primary"
                    android:gravity="center"
                    android:paddingHorizontal="20dp" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Product Grid (2 columns layout using vertical linear layouts) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <!-- Product 1: Madu HPAI -->
            <LinearLayout
                android:id="@+id/cardMadu"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_tab_selected"
                android:orientation="vertical"
                android:padding="12dp"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/images"
                    android:layout_marginBottom="8dp"
                    android:contentDescription="Madu HPAI" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Madu HPAI"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/simaju_text_primary"
                    android:layout_marginBottom="4dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="★ 4.8"
                        android:textSize="12sp"
                        android:textColor="#FFA726"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Rp 85.000"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/simaju_green" />

                    <!-- Add Button -->
                    <FrameLayout
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_primary_button">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="+"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/white"
                            android:gravity="center" />
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Product 2: Kopi -->
            <LinearLayout
                android:id="@+id/cardKopi"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_tab_selected"
                android:orientation="vertical"
                android:padding="12dp"
                android:layout_marginStart="8dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/images_kopi"
                    android:layout_marginBottom="8dp"
                    android:contentDescription="Kopi" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kopi"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/simaju_text_primary"
                    android:layout_marginBottom="4dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="★ 4.6"
                        android:textSize="12sp"
                        android:textColor="#FFA726"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Rp 45.000"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/simaju_green" />

                    <!-- Add Button -->
                    <FrameLayout
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_primary_button">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="+"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/white"
                            android:gravity="center" />
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Product Grid Row 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <!-- Product 3: Minyak HPAI -->
            <LinearLayout
                android:id="@+id/cardMinyak"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_tab_selected"
                android:orientation="vertical"
                android:padding="12dp"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/images_minyak"
                    android:layout_marginBottom="8dp"
                    android:contentDescription="Minyak HPAI" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Minyak HPAI"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/simaju_text_primary"
                    android:layout_marginBottom="4dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="★ 4.9"
                        android:textSize="12sp"
                        android:textColor="#FFA726"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Rp 120.000"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/simaju_green" />

                    <!-- Add Button -->
                    <FrameLayout
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_primary_button">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="+"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/white"
                            android:gravity="center" />
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Product 4: Susu HPAI -->
            <LinearLayout
                android:id="@+id/cardSusu"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_tab_selected"
                android:orientation="vertical"
                android:padding="12dp"
                android:layout_marginStart="8dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/images_susu"
                    android:layout_marginBottom="8dp"
                    android:contentDescription="Susu HPAI" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Susu HPAI"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/simaju_text_primary"
                    android:layout_marginBottom="4dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="★ 4.5"
                        android:textSize="12sp"
                        android:textColor="#FFA726"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Rp 55.000"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/simaju_green" />

                    <!-- Add Button -->
                    <FrameLayout
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_primary_button">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="+"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/white"
                            android:gravity="center" />
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Store Location Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_tab_selected"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">

                    <!-- Green dot -->
                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/bg_primary_button"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Buka • 08.00–20.00"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/simaju_green" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BC HPAI Yogyakarta 2"
                    android:textSize="13sp"
                    android:textColor="@color/simaju_text_secondary" />
            </LinearLayout>

            <!-- Lihat Lokasi Button -->
            <TextView
                android:id="@+id/btnLihatLokasi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tab_selected"
                android:text="Lihat Lokasi"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/simaju_green"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
