<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_tab_selected"
    android:padding="14dp"
    android:layout_marginBottom="12dp">

    <!-- Top Row: Thumbnail + Details -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="top">

        <FrameLayout
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:background="@drawable/bg_product_thumb"
            android:padding="4dp">

            <ImageView
                android:id="@+id/ivOwnerProductThumb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/images"
                android:contentDescription="Gambar Produk" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/tvOwnerProductName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Madu HPAI"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/simaju_text_primary"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvOwnerProductCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_green"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:layout_marginTop="5dp"
                android:text="🌿 Herbal"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/simaju_green"
                android:maxLines="1"
                android:ellipsize="end" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/tvOwnerProductPrice"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Rp 85.000"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/simaju_green" />

                <TextView
                    android:id="@+id/tvOwnerProductStock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_neutral"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="Stok: 20"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/simaju_text_primary" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/simaju_input_stroke"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="10dp" />

    <!-- Bottom Action Row (Mobile-Friendly Touch Targets) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/btnEditProduct"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:background="@drawable/bg_badge_neutral"
            android:foreground="?attr/selectableItemBackground"
            android:orientation="horizontal"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="6dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_edit"
                app:tint="@color/simaju_text_primary"
                android:layout_marginEnd="6dp"
                android:contentDescription="Edit" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Edit"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/simaju_text_primary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnDeleteProduct"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:background="@drawable/bg_badge_danger"
            android:foreground="?attr/selectableItemBackground"
            android:orientation="horizontal"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginStart="6dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_delete"
                app:tint="@color/merah_tua"
                android:layout_marginEnd="6dp"
                android:contentDescription="Hapus" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hapus"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/merah_tua" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
